# ====================================================================
# YouTube to Telegram Music Downloader Bot - Environment Configuration
# ====================================================================

# --------------------------------------------------------------------
# Core Settings
# --------------------------------------------------------------------

# Required: Telegram Bot Token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Optional: Restrict bot usage to specific numerical Telegram user IDs (comma-separated).
# Leave empty to allow any user to use the bot.
# Example: ALLOWED_USERS="123456789,987654321"
ALLOWED_USERS=""

# Ephemeral folder path for downloading and converting audio files
DOWNLOAD_DIR="./downloads"

# --------------------------------------------------------------------
# Audio Settings
# --------------------------------------------------------------------

# Audio output bitrate in kbps (192 recommended)
AUDIO_BITRATE=192

# Default audio format ("mp3" or "m4a")
DEFAULT_AUDIO_FORMAT="mp3"

# Maximum allowable file size in Megabytes before rejecting Telegram upload (Standard Bot API limit: 50MB)
MAX_FILE_SIZE_MB=50

# Maximum number of tracks to download per playlist or YouTube Radio Mix
MAX_PLAYLIST_TRACKS=25

# --------------------------------------------------------------------
# Cache Settings
# --------------------------------------------------------------------

# Redis Server URL for ultra-fast audio caching (Telegram file_id) and distributed queue
# Default: redis://localhost:6379/0 (or redis://redis:6379/0 inside Docker Compose)
# If Redis is unavailable, the bot will automatically fall back to SQLite cache
REDIS_URL="redis://localhost:6379/0"

# Audio Cache TTL in days (auto-expire cached file_id records after N days)
CACHE_TTL_DAYS=30

# --------------------------------------------------------------------
# Scaling & Distributed Architecture
# --------------------------------------------------------------------

# Maximum concurrent download & conversion tasks (bounds CPU and RAM usage)
MAX_CONCURRENT_DOWNLOADS=5

# Distributed worker mode (offloads downloads to ARQ workers via Redis)
WORKER_MODE=false

# Local Telegram Bot API Server (Unlocks 2GB uploads and LAN zero-copy transfer)
TELEGRAM_API_SERVER_URL=""
TELEGRAM_LOCAL_MODE=false
# Needed if using the aiogram/telegram-bot-api docker image:
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# Webhook mode for high-throughput ingestion (requires HTTPS domain and Reverse Proxy)
WEBHOOK_MODE=false
WEBHOOK_URL=""
WEBHOOK_PORT=8000
WEBHOOK_SECRET=""

# --------------------------------------------------------------------
# Proxy Protection
# --------------------------------------------------------------------

# Optional: Path to exported YouTube cookies file (e.g. cookies.txt) to bypass bot verification
YOUTUBE_COOKIES_FILE=""

# Optional: HTTP/SOCKS5 proxy URL for YouTube extraction (recommended for datacenter VPS IPs)
# Example: YOUTUBE_PROXY="http://user:pass@proxy.example.com:8080"
YOUTUBE_PROXY=""
YOUTUBE_PROXY_POOL=""

# --------------------------------------------------------------------
# Rate Limiting
# --------------------------------------------------------------------

# Per-user rate limit (max requests per window)
USER_RATE_LIMIT=5

# Rate limit window in seconds
USER_RATE_WINDOW=60

# --------------------------------------------------------------------
# Logging & Observability
# --------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"

# Log format: "colored" for development, "json" for production logging aggregation
LOG_FORMAT="colored"
